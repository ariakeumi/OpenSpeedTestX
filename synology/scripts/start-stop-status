#!/bin/sh

set -eu

SERVICE_NAME="OpenSpeedTestX"
BINARY="${SYNOPKG_PKGDEST}/bin/openspeedtestx"
APP_ROOT="${SYNOPKG_PKGDEST}/share/openspeedtestx"
DATA_DIR="${SYNOPKG_PKGVAR}"
LOG_DIR="${DATA_DIR}/log"
PID_FILE="${DATA_DIR}/openspeedtestx.pid"
STDOUT_LOG="${LOG_DIR}/stdout.log"
STDERR_LOG="${LOG_DIR}/stderr.log"
PORT="${SYNOPKG_PKGPORT:-3000}"

report() {
	if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
		echo "$1" > "${SYNOPKG_TEMP_LOGFILE}"
	fi
}

read_pid() {
	if [ ! -f "$PID_FILE" ]; then
		return 1
	fi
	PID=$(cat "$PID_FILE" 2>/dev/null || true)
	if [ -z "${PID:-}" ]; then
		return 1
	fi
	return 0
}

is_running() {
	if ! read_pid; then
		return 1
	fi
	kill -0 "$PID" 2>/dev/null
}

start_service() {
	if is_running; then
		return 0
	fi

	if [ ! -x "$BINARY" ]; then
		report "$SERVICE_NAME binary not found: $BINARY"
		return 1
	fi

	if [ ! -d "$APP_ROOT" ]; then
		report "$SERVICE_NAME web root not found: $APP_ROOT"
		return 1
	fi

	mkdir -p "$LOG_DIR"

	nohup "$BINARY" \
		-addr ":$PORT" \
		-root "$APP_ROOT" \
		-data-file "$DATA_DIR/history.json" \
		>>"$STDOUT_LOG" 2>>"$STDERR_LOG" &
	echo "$!" > "$PID_FILE"

	sleep 1
	if is_running; then
		return 0
	fi

	report "$SERVICE_NAME failed to start. Check $STDERR_LOG."
	return 1
}

stop_service() {
	if ! read_pid; then
		rm -f "$PID_FILE"
		return 0
	fi

	if kill -0 "$PID" 2>/dev/null; then
		kill "$PID" 2>/dev/null || true

		TRY=0
		while kill -0 "$PID" 2>/dev/null; do
			TRY=$((TRY + 1))
			if [ "$TRY" -ge 20 ]; then
				kill -9 "$PID" 2>/dev/null || true
				break
			fi
			sleep 1
		done
	fi

	rm -f "$PID_FILE"
	return 0
}

case "${1:-}" in
	prestart)
		if [ ! -x "$BINARY" ]; then
			report "$SERVICE_NAME binary not found: $BINARY"
			exit 1
		fi
		exit 0
		;;
	start)
		start_service
		exit $?
		;;
	prestop)
		exit 0
		;;
	stop)
		stop_service
		exit 0
		;;
	status)
		if is_running; then
			exit 0
		fi
		if [ -f "$PID_FILE" ]; then
			exit 1
		fi
		exit 3
		;;
	*)
		exit 1
		;;
esac
